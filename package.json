{
  "name": "connected",
  "version": "0.1.0",
  "private": true,
  "description": "Hand-drawn conversation sketches from a screenplay-style text file",
  "type": "module",
  "scripts": {
    "build": "node --import tsx src/cli.ts build",
    "check": "node --import tsx src/cli.ts check",
    "pin": "node --import tsx src/cli.ts pin",
    "fixture": "node --import tsx src/cli.ts fixture",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
